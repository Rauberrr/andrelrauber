# Senha do banco de dados: nunca vai para o repositório
api/config.php

# Configuração local do ambiente de visualização
.claude/
api/fotos-pecas/*
!api/fotos-pecas/.htaccess

# Fotos originais das peças sugeridas. O site usa as versões sem fundo, em assets/img/sugeridas.
imagens-guarda-roupa/

# Respostas guardadas do clima e dos preços: o servidor refaz sozinho
api/cache/

# Chaves dos lembretes (Web Push), tokens das redes e vídeos esperando publicação: só no servidor
api/privado/

# Fotos dos produtos da coleção, enviadas pelo painel
api/fotos-produtos/*

# Fotos das peças do catálogo do guarda-roupa, enviadas pelo painel
api/fotos-catalogo/*
